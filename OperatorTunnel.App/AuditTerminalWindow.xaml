<Window x:Class="OperatorTunnel.App.AuditTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Terminal" Width="980" Height="660"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#020604" />
        <SolidColorBrush x:Key="Panel" Color="#07110B" />
        <SolidColorBrush x:Key="Line" Color="#1B4728" />
        <SolidColorBrush x:Key="Neon" Color="#8CFF8A" />
        <SolidColorBrush x:Key="Muted" Color="#729179" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#030805" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0A2111" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[ AUDIT TERMINAL ]" Foreground="{StaticResource Neon}" FontWeight="Bold" FontSize="13" />
                    <TextBlock x:Name="SessionLabel" Foreground="{StaticResource Muted}" Margin="12,1,0,0" FontSize="10" />
                </StackPanel>
                <Button Content="×" HorizontalAlignment="Right" Width="34" Height="28" Padding="0" Click="CloseButton_Click" />
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,12">
                <StackPanel>
                    <TextBlock Text="// AUTHORIZED NMAP TARGETS ONLY" Foreground="{StaticResource Muted}" FontSize="10" />
                    <TextBlock Text="Targets (IP, CIDR, or hostname; space separated)" Foreground="{StaticResource Muted}" Margin="0,12,0,5" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="[ RUN NMAP ]" Click="RunButton_Click" />
                        <TextBox x:Name="TargetsTextBox" Text="10.10.20.15" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBox x:Name="OutputTextBox" Grid.Row="2" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            <TextBlock x:Name="StatusText" Grid.Row="3" Text="ready // Nmap XML output will be parsed into the active session" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>
