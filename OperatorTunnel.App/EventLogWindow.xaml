<Window x:Class="OperatorTunnel.App.EventLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event Log" Width="900" Height="560" MinWidth="720" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#D8F8D7" FontFamily="Cascadia Mono, Consolas" WindowStartupLocation="CenterOwner">
    <Border Background="#020604" BorderBrush="#2E7038" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="[ EVENT LOG ]" Foreground="#A8FF3E" FontWeight="Bold" FontSize="14" /><TextBlock Text="  //  REDACTED SECURITY TELEMETRY" Foreground="#6E9276" FontSize="10" Margin="12,2,0,0" /></StackPanel>
                <Button Content="×" Click="CloseButton_Click" HorizontalAlignment="Right" Width="34" Height="28" Background="Transparent" Foreground="#A8FF3E" BorderThickness="0" FontSize="18" Cursor="Hand" />
            </Grid>
            <Border Grid.Row="2" Background="#07110B" BorderBrush="#173D22" BorderThickness="1" CornerRadius="8" Padding="10">
                <ListView x:Name="EventItems" Background="Transparent" BorderThickness="0" Foreground="#D8F8D7" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate><DataTemplate><Grid Margin="4,7"><Grid.ColumnDefinitions><ColumnDefinition Width="175" /><ColumnDefinition Width="90" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Foreground="#6E9276" FontSize="11" /><TextBlock Grid.Column="1" Text="{Binding Severity}" Foreground="#A8FF3E" FontSize="11" /><TextBlock Grid.Column="2" Text="{Binding Code}" Foreground="#8FD3A0" FontSize="11" /><TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#D8F8D7" FontSize="11" TextWrapping="Wrap" /></Grid></DataTemplate></ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Border>
</Window>

