<Window x:Class="OperatorTunnel.App.AuditFindingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Findings"
        Width="1120"
        Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#020604" />
        <SolidColorBrush x:Key="Panel" Color="#07110B" />
        <SolidColorBrush x:Key="Line" Color="#1B4728" />
        <SolidColorBrush x:Key="Neon" Color="#8CFF8A" />
        <SolidColorBrush x:Key="Muted" Color="#729179" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#061009" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,5,0,10" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#061009" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,5,0,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0A2111" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,0,7,7" />
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[ FINDINGS ]" Foreground="{StaticResource Neon}" FontWeight="Bold" FontSize="13" />
                    <TextBlock x:Name="SessionLabel" Foreground="{StaticResource Muted}" Margin="12,1,0,0" FontSize="10" />
                </StackPanel>
                <Button Content="×" HorizontalAlignment="Right" Width="34" Height="28" Padding="0" Click="CloseButton_Click" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="FindingsList" Grid.Column="0" Background="{StaticResource Panel}" Foreground="{StaticResource Neon}" BorderBrush="{StaticResource Line}" FontFamily="Consolas" SelectionChanged="FindingsList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="STATUS" DisplayMemberBinding="{Binding Status}" Width="165" />
                            <GridViewColumn Header="SEVERITY" DisplayMemberBinding="{Binding Severity}" Width="90" />
                            <GridViewColumn Header="TITLE" DisplayMemberBinding="{Binding Title}" Width="235" />
                            <GridViewColumn Header="ASSET" DisplayMemberBinding="{Binding AffectedAsset}" Width="190" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="// FINDING CONTROL" Foreground="{StaticResource Muted}" FontSize="10" />
                            <TextBlock Text="Title" Foreground="{StaticResource Muted}" Margin="0,16,0,0" />
                            <TextBox x:Name="TitleTextBox" />
                            <TextBlock Text="Affected asset" Foreground="{StaticResource Muted}" />
                            <TextBox x:Name="AssetTextBox" />
                            <TextBlock Text="Severity" Foreground="{StaticResource Muted}" />
                            <ComboBox x:Name="SeverityComboBox" />
                            <TextBlock Text="Evidence ID" Foreground="{StaticResource Muted}" />
                            <TextBox x:Name="EvidenceTextBox" />
                            <TextBlock Text="Description / verification notes" Foreground="{StaticResource Muted}" />
                            <TextBox x:Name="NotesTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" />
                            <WrapPanel>
                                <Button Content="[ CREATE POTENTIAL ]" Click="CreateButton_Click" />
                                <Button Content="[ REQUIRE VERIFY ]" Click="RequireVerificationButton_Click" />
                                <Button Content="[ VERIFY ]" Click="VerifyButton_Click" />
                                <Button Content="[ NOT AFFECTED ]" Click="NotAffectedButton_Click" />
                                <Button Content="[ FALSE POSITIVE ]" Click="FalsePositiveButton_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="StatusText" Text="ready // potential exposures require verification" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
