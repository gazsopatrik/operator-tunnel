<Window x:Class="OperatorTunnel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator Tunnel" Height="760" Width="1280" MinHeight="680" MinWidth="1050"
        Background="#020604" Foreground="#D8F8D7" FontFamily="Cascadia Mono, Consolas" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#07110B" />
        <SolidColorBrush x:Key="PanelAlt" Color="#040A06" />
        <SolidColorBrush x:Key="Line" Color="#173D22" />
        <SolidColorBrush x:Key="Muted" Color="#6E9276" />
        <SolidColorBrush x:Key="Neon" Color="#A8FF3E" />
        <SolidColorBrush x:Key="Green" Color="#45FF88" />
        <SolidColorBrush x:Key="Warning" Color="#E5FF57" />
        <Style x:Key="Nav" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,12" /><Setter Property="FontSize" Value="12" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0D2414" /><Setter Property="Foreground" Value="{StaticResource Neon}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="Foreground" Value="#D8F8D7" /><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Storyboard x:Key="ScanlineAnimation"><DoubleAnimation Storyboard.TargetName="Scanline" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-20" To="760" Duration="0:0:07" RepeatBehavior="Forever" /></Storyboard>
        <Storyboard x:Key="CursorAnimation"><DoubleAnimation Storyboard.TargetName="CursorGlyph" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever" /></Storyboard>
        <Storyboard x:Key="FlickerAnimation"><DoubleAnimation Storyboard.TargetName="FlickerText" Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.12" AutoReverse="True" RepeatBehavior="Forever" /></Storyboard>
        <Storyboard x:Key="PulseAnimation"><DoubleAnimation Storyboard.TargetName="StatusDot" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" /></Storyboard>
        <Storyboard x:Key="AmbientLineAnimation"><DoubleAnimation Storyboard.TargetName="AmbientLine" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="-180" To="760" Duration="0:0:11" RepeatBehavior="Forever" /></Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard Storyboard="{StaticResource ScanlineAnimation}" /><BeginStoryboard Storyboard="{StaticResource CursorAnimation}" /><BeginStoryboard Storyboard="{StaticResource FlickerAnimation}" /><BeginStoryboard Storyboard="{StaticResource PulseAnimation}" /><BeginStoryboard Storyboard="{StaticResource AmbientLineAnimation}" /></EventTrigger>
    </Window.Triggers>
    <Grid Margin="22" ClipToBounds="True" Background="#020604">
        <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="0,54,0,0" Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,6,0,32"><Border Width="30" Height="30" CornerRadius="6" Background="#0A2A13" BorderBrush="{StaticResource Neon}" BorderThickness="1"><TextBlock Text="&gt;_" Foreground="{StaticResource Neon}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="OPERATOR" FontSize="13" FontWeight="Bold" /><TextBlock Text="TUNNEL // 0.1" FontSize="9" Foreground="{StaticResource Neon}" /></StackPanel></StackPanel>
                    <TextBlock Text="// CONTROL PLANE" FontSize="10" Foreground="{StaticResource Muted}" Margin="5,0,0,10" /><Button Style="{StaticResource Nav}" Content="[01]  OVERVIEW" Foreground="{StaticResource Neon}" Background="#0D2414" /><Button Style="{StaticResource Nav}" Content="[02]  PROFILES" /><Button Style="{StaticResource Nav}" Content="[03]  NETWORK POLICY" /><Button Style="{StaticResource Nav}" Content="[04]  EVENT LOG" />
                    <TextBlock Text="// AUDIT WORKSPACE" FontSize="10" Foreground="{StaticResource Muted}" Margin="5,28,0,10" /><Button Style="{StaticResource Nav}" Content="[05]  AUDIT PROJECTS" /><Button Style="{StaticResource Nav}" Content="[06]  SECURITY MODEL" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#07170B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,20,0,0"><StackPanel><TextBlock Text="BACKEND STATUS" FontSize="9" Foreground="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" /><TextBlock Text="  WireGuard service" FontSize="11" Margin="5,0,0,0" /></StackPanel><TextBlock Text="not connected" FontSize="10" Foreground="{StaticResource Muted}" Margin="12,4,0,0" /></StackPanel></Border>
            </DockPanel>
        </Border>
        <Grid Grid.Column="2" Margin="0,54,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0"><StackPanel><TextBlock x:Name="FlickerText" Text="SYSTEM // NETWORK OPERATIONS" FontSize="11" Foreground="{StaticResource Neon}" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal"><TextBlock Text="Your tunnel, at a glance" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" /><TextBlock x:Name="CursorGlyph" Text="_" FontSize="28" Foreground="{StaticResource Neon}" Margin="8,6,0,0" /></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock Text="LOCAL MODE // DEMO STATE" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" /><Button Content="[+] IMPORT PROFILE" Click="ImportProfile_Click" Padding="14,9" Background="#0A2111" Foreground="{StaticResource Neon}" BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand" /></StackPanel></Grid>
            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#6A8370" VerticalAlignment="Center" /><TextBlock x:Name="StatusLabel" Text="TUNNEL OFFLINE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" /></StackPanel><TextBlock Text="No active WireGuard tunnel" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,4" /><TextBlock x:Name="ProfileLabel" Text="Select a profile to begin" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel><Button x:Name="ConnectButton" Grid.Column="1" Content="CONNECT" Click="ConnectButton_Click" Width="144" Height="52" Background="#0C2A16" Foreground="{StaticResource Neon}" BorderBrush="{StaticResource Neon}" BorderThickness="1" FontWeight="Bold" Cursor="Hand" /></Grid></Border>
            <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="// ACTIVE PROFILE" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,10" /><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><Grid><TextBlock Text="No profile loaded" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="PROFILE / —" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10" /></Grid><Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,16" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="INTERFACE" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="—" Style="{StaticResource Metric}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ENDPOINT" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="—" Style="{StaticResource Metric}" /></StackPanel></Grid><TextBlock Text="ALLOWED IPS" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,20,0,7" /><TextBlock Text="No routing rules loaded" Foreground="#A9C5AA" FontSize="12" /></StackPanel></Border><TextBlock Text="// TELEMETRY" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,24,0,10" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="HANDSHAKE" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="—" Style="{StaticResource Metric}" /><TextBlock Text="waiting for tunnel" Foreground="{StaticResource Muted}" FontSize="10" /></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="TRANSFER" Foreground="{StaticResource Muted}" FontSize="10" /><TextBlock Text="—" Style="{StaticResource Metric}" /><TextBlock Text="up / down" Foreground="{StaticResource Muted}" FontSize="10" /></StackPanel></Border></Grid></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="// SECURITY POSTURE" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,10" /><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="Pre-flight checks" FontSize="16" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Margin="0,20,0,13"><TextBlock Text="[ ]" Foreground="{StaticResource Muted}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="DNS policy" /><TextBlock Text="not evaluated" Foreground="{StaticResource Muted}" FontSize="10" /></StackPanel></StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,13"><TextBlock Text="[ ]" Foreground="{StaticResource Muted}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="Kill switch" /><TextBlock Text="policy not configured" Foreground="{StaticResource Muted}" FontSize="10" /></StackPanel></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="[ ]" Foreground="{StaticResource Muted}" /><StackPanel Margin="10,0,0,0"><TextBlock Text="Config validation" /><TextBlock Text="awaiting profile" Foreground="{StaticResource Muted}" FontSize="10" /></StackPanel></StackPanel></StackPanel></Border><Border Background="#07170B" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,20,0,0"><StackPanel><TextBlock Text="SECURITY NOTE" Foreground="{StaticResource Neon}" FontSize="10" FontWeight="Bold" /><TextBlock Text="Operator Tunnel does not implement cryptography. WireGuard remains the protocol and crypto boundary." TextWrapping="Wrap" Foreground="#A9C5AA" FontSize="11" Margin="0,8,0,0" /></StackPanel></Border></StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Column="0" Grid.ColumnSpan="3" Height="42" VerticalAlignment="Top" Background="#06130A" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="14,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="[ OPERATOR TUNNEL ]" Foreground="{StaticResource Neon}" FontWeight="Bold" FontSize="12" /><TextBlock Text="  //  SECURE CONTROL PLANE" Foreground="{StaticResource Muted}" FontSize="10" Margin="12,1,0,0" /><TextBlock Text="  ▮" Foreground="{StaticResource Green}" FontSize="11" /></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="DEMO BACKEND" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,0,20,0" /><Button Content="_" Click="MinimizeButton_Click" Width="34" Height="26" Background="Transparent" Foreground="{StaticResource Muted}" BorderThickness="0" FontSize="14" Cursor="Hand" /><Button Content="×" Click="CloseButton_Click" Width="34" Height="26" Background="Transparent" Foreground="{StaticResource Neon}" BorderThickness="0" FontSize="18" Cursor="Hand" /></StackPanel>
            </Grid>
        </Border>
        <Border x:Name="AmbientLine" Grid.Column="2" Height="1" VerticalAlignment="Top" Margin="0,54,0,0" Background="{StaticResource Neon}" Opacity="0.22" IsHitTestVisible="False" RenderTransformOrigin="0.5,0"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border>
        <Border x:Name="Scanline" Grid.Column="2" Height="2" VerticalAlignment="Top" Background="{StaticResource Neon}" Opacity="0.16" IsHitTestVisible="False" RenderTransformOrigin="0.5,0"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border>
    </Grid>
</Window>
