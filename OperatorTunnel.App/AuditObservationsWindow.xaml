<Window x:Class="OperatorTunnel.App.AuditObservationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Observations"
        Width="1040"
        Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#020604" />
        <SolidColorBrush x:Key="Panel" Color="#07110B" />
        <SolidColorBrush x:Key="Line" Color="#1B4728" />
        <SolidColorBrush x:Key="Neon" Color="#8CFF8A" />
        <SolidColorBrush x:Key="Muted" Color="#729179" />
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#0A2111" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#102A18" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[ OBSERVATIONS ]" Foreground="{StaticResource Neon}" FontWeight="Bold" FontSize="13" />
                    <TextBlock x:Name="SessionLabel" Foreground="{StaticResource Muted}" Margin="12,1,0,0" FontSize="10" />
                </StackPanel>
                <Button Content="×" HorizontalAlignment="Right" Width="34" Height="28" Padding="0" Click="CloseButton_Click" />
            </Grid>
            <ListView x:Name="ObservationsList" Grid.Row="1" Margin="0,18,0,0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="KIND" DisplayMemberBinding="{Binding Kind}" Width="125" />
                        <GridViewColumn Header="VALUE" DisplayMemberBinding="{Binding Value}" Width="390" />
                        <GridViewColumn Header="SOURCE" DisplayMemberBinding="{Binding Source}" Width="100" />
                        <GridViewColumn Header="OBSERVED" DisplayMemberBinding="{Binding ObservedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="170" />
                        <GridViewColumn Header="EVIDENCE" DisplayMemberBinding="{Binding RawEvidenceId}" Width="180" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>
