<Window x:Class="OperatorTunnel.App.AuditProjectManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Projects"
        Width="900"
        Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#020604" />
        <SolidColorBrush x:Key="Panel" Color="#07110B" />
        <SolidColorBrush x:Key="PanelAlt" Color="#0A1710" />
        <SolidColorBrush x:Key="Line" Color="#1B4728" />
        <SolidColorBrush x:Key="Neon" Color="#8CFF8A" />
        <SolidColorBrush x:Key="Muted" Color="#729179" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#061009" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,6,0,14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0A2111" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Neon}" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="{StaticResource PanelAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[ AUDIT PROJECTS ]" Foreground="{StaticResource Neon}" FontWeight="Bold" FontSize="13" />
                    <TextBlock Text="  //  PERSISTENT WORKSPACE" Foreground="{StaticResource Muted}" Margin="12,1,0,0" FontSize="10" />
                </StackPanel>
                <Button Content="×" HorizontalAlignment="Right" Width="34" Height="28" Padding="0" Click="CloseButton_Click" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="// PROJECT REGISTRY" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,10" />
                    <ListBox x:Name="ProjectsList" SelectionChanged="ProjectsList_SelectionChanged" />
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <TextBlock Text="// PROJECT CONTROL" Foreground="{StaticResource Muted}" FontSize="10" />
                        <TextBlock Text="Project name" Foreground="{StaticResource Muted}" Margin="0,20,0,0" />
                        <TextBox x:Name="NameTextBox" />
                        <TextBlock Text="Assessment scope" Foreground="{StaticResource Muted}" />
                        <TextBox x:Name="ScopeTextBox" />
                        <TextBlock Text="// PROJECT ACTIONS" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,5" />
                        <WrapPanel>
                            <Button Content="[ CREATE ]" Click="CreateButton_Click" />
                            <Button Content="[ SAVE ]" Click="SaveButton_Click" />
                            <Button Content="[ CLEAR ]" Click="ClearButton_Click" />
                            <Button Content="[ DELETE ]" Click="DeleteButton_Click" />
                        </WrapPanel>
                        <TextBlock Text="// SESSION CONTROL" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,7,0,5" />
                        <WrapPanel>
                            <Button Content="[ START SESSION ]" Click="StartSessionButton_Click" />
                            <Button Content="[ END SESSION ]" Click="EndSessionButton_Click" />
                        </WrapPanel>
                        <TextBlock Text="// DATA PIPELINE" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,7,0,5" />
                        <WrapPanel>
                            <Button Content="[ IMPORT NMAP XML ]" Click="ImportNmapButton_Click" FontSize="10" />
                            <Button Content="[ VIEW OBSERVATIONS ]" Click="ViewObservationsButton_Click" FontSize="10" />
                            <Button Content="[ VIEW FINDINGS ]" Click="ViewFindingsButton_Click" FontSize="10" />
                        </WrapPanel>
                        <TextBlock x:Name="StatusText" Text="ready // select or create a project" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,22,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Grid.Row="2" Text="AUDIT METADATA ONLY // VPN SECRETS ARE STORED BY THE TUNNEL MODULE" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</Window>
