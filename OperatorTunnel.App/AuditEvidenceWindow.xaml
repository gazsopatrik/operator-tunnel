<Window x:Class="OperatorTunnel.App.AuditEvidenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Evidence"
        Width="1100"
        Height="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#020604" />
        <SolidColorBrush x:Key="Panel" Color="#07110B" />
        <SolidColorBrush x:Key="Line" Color="#1B4728" />
        <SolidColorBrush x:Key="Neon" Color="#8CFF8A" />
        <SolidColorBrush x:Key="Muted" Color="#729179" />
    </Window.Resources>
    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="[ EVIDENCE ]" Foreground="{StaticResource Neon}" FontWeight="Bold" FontSize="13" />
                    <TextBlock x:Name="SessionLabel" Foreground="{StaticResource Muted}" Margin="12,1,0,0" FontSize="10" />
                </StackPanel>
                <Button Content="×" HorizontalAlignment="Right" Width="34" Height="28" Padding="0" Click="CloseButton_Click" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <ListView x:Name="EvidenceList" Grid.Column="0" Background="{StaticResource Panel}" Foreground="{StaticResource Neon}" BorderBrush="{StaticResource Line}" SelectionChanged="EvidenceList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="SOURCE" DisplayMemberBinding="{Binding Source}" Width="90" />
                            <GridViewColumn Header="FILE" DisplayMemberBinding="{Binding FileName}" Width="180" />
                            <GridViewColumn Header="CAPTURED" DisplayMemberBinding="{Binding CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="160" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="RAW EVIDENCE" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,10" />
                        <TextBox x:Name="ContentTextBox" Background="#030805" Foreground="{StaticResource Neon}" BorderBrush="{StaticResource Line}" BorderThickness="1" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                        <TextBlock x:Name="MetadataText" DockPanel.Dock="Bottom" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
